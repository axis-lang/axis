fn compute
#    Computes complex values based on an operation mode.
takes:
# aqui podemos ver valores

    val a: Number
    # The first operand.

    val b: Number
    # The second operand.

    val mode: String
    # Operation mode; valid values include "add", "subtract", "multiply".

returns Number
#   The computed result.
suite:
    if mode == "add":
         return a + b
    elif mode == "subtract":
         return a - b
    elif mode == "multiply":
         return a * b
    else:
         error: Unsupported operation mode


fn recursiveFactorial

takes:
    val n: Number
        # A non-negative integer.

returns Number
# Factorial of n.

suite:
    if n <= 1:
         return 1
    else:
         return n * recursiveFactorial(n - 1)


fn divide
#    Divides two numbers and handles division by zero.

takes:
    val numerator: Number
    # The numerator.

    val denominator: Number
    # The denominator; must not be zero.
    
returns Number
#    The result of the division.

suite:
    if denominator == 0:
         error: Division by zero encountered.
    else:
         return numerator / denominator