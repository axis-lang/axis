def Number
abstract
where:
    val Min: Self
    val Max: Self

def Natural
where:
    val BitLength: Optional Natural = None


def Integer
where:
    val BitLength: Optional Natural = None


def Decimal
where:
    val ExpMagnitude: Natural = 1e7 - 1 # -999999..999999
    val Precission: Natural = 28
    val Traps: Set Trap = {}

namespace:

    def Trap
    enum:
        val Clamped
        val InvalidOperation
        val DivisionByZero
        val Inexact
        val Rounded
        val Subnormal
        val Overflow
        val Underflow
        val FloatOperation

    use Trap { .. } 


def Bit
extends Natural[BitLength=1]
enum:
    val False = 0
    val True = 1

use Bit { .. } 


def Byte:
extends Natural[BitLength=8]


def Set


