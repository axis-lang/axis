unit std

def Boolean
def Natural
def Whole
def Integer
def Real
def Text
def Sym


def Optional T
where: 
    val T: Type


def Array[..extent] T
where: 
    val extent: Array[rank] Natural
    val rank: Natural


def Struct[I] T
where: 
    val I: Struct.Index[N] Sym
    val N: Whole
    val T: Type = Sym
