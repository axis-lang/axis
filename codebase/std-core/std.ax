unit std

use std(
    core(...),
    types(...),
    qualifiers(...),
)

mod core
    def Any
    def Empty
    def Boolean
    def Natural
    def Whole
    def Integer
    def Decimal
    def Text

    def Struct[K] V
    where:
        val K: Type
        val V: Type
    takes: 
        val index: Index K
        val values: List V

    def Index K
    where:
        val K: Type
    takes: 
        val keys: List K | Missing



mod types
    def Type

    def Anchor(path)
        ------------
        Anchors are used to refer to items by their path. 
        They are used in the Spec and NominalType items.

    takes:
        val path: Text

    def Spec[..S](anchor, args)
        -----------------------
        Specs are used to refer to items by their path and arguments. 
        They are used in the NominalType and NominalQualifier items.
    where:
        val S: qualifiers.Struct Type
    takes:
        val anchor: Anchor
        val args: S
    
    def StructType[I](meta_attrs)
    where:
        val I: Type
    takes:
        val meta_attrs: qualifiers.Struct[I] Type

    def NominalType[S](spec_ref)
    where:
        val S: Type
    takes:
        val spec_ref: Spec[S]

    def NominalQualifier[S] U
    where:
        val S: Type
        val U: Type
    takes:
        val spec_ref: Spec[S]
        val underlying: U

    def UnionType[T](types)
    where:
        val T: Type
    takes:
        val types: List T

    def VarType
    def ErrType


mod qualifiers
    def Optional T
    where:
        val T: Type

    def Array[..Dims] T
    where:
        val Dims: Type
        val T: Type

    def Struct[I] T
    where:
        val I: Type   
        val T: Type

    def Map[K] V
    where:
        val K: Type
        val V: Type

    def Set V
    where:
        val V: Type

    def List V
    where:
        val V: Type
    
