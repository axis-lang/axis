unit std

mod core
    def Any
    def Empty
    def Boolean
    def Natural
    def Whole
    def Integer
    def Decimal
    def Text
    def Sym


mod types
    def Type

    def Anchor(path)
    takes:
        val path: core.Text

    def Spec[S](anchor, args)
    where:
        val S: types.Type
    takes:
        val anchor: types.Anchor
        val args: S

    def StructType[I](meta_attrs)
    where:
        val I: types.Type
    takes:
        val meta_attrs: qualifiers.Struct[I] types.Type

    def NominalType[S](spec_ref)
    where:
        val S: types.Type
    takes:
        val spec_ref: types.Spec[S]

    def NominalQualifier[S] U
    where:
        val S: types.Type
        val U: types.Type
    takes:
        val spec_ref: types.Spec[S]
        val underlying: U

    def UnionType[T](types)
    where:
        val T: types.Type
    takes:
        val types: qualifiers.List T

    def VarType
    def ErrType


mod qualifiers
    def Optional T
    where:
        val T: types.Type

    def Array[..Dims] T
    where:
        val Dims: types.Type
        val T: types.Type

    def Struct[I] T
    where:
        val I: types.Type
        val T: types.Type

    def Map[K] V
    where:
        val K: types.Type
        val V: types.Type

    def Set V
    where:
        val V: types.Type

    def List V
    where:
        val V: types.Type
