unit sandbox.demo

use sandbox.basic(...)

def Token

def Point
takes:
    val x: Number
    val y: Number

def Add
takes:
    val a: Number
    val b: Number
returns Number

def Default
returns T
where:
    val T: Type

def Id
takes:
    val x: Number
returns Number

takes:
    val x: Text
returns Text

def Clamp
takes:
    val x: Number
    val lo: Number = 0
    val hi: Number = 1
returns Number

val zero: Number = 0
val one: Number = 1
val origin: Point = (0, 0)

val any_set: Set Natural = (1,2,3)
