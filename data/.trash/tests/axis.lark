// Gramática Lark para un lenguaje estilo Kotlin (partes imperativas y declarativas)

// Regla inicial: Un programa puede contener cualquier número de declaraciones o sentencias.
start: (statement | declaration)*

// Declaraciones (parte declarativa)
declaration: class_declaration 
           | function_declaration 
           | property_declaration

// Declaración de clase (simplificada)
class_declaration: CLASS simple_identifier class_parameters? class_body?
// Opcionalmente con parámetros de constructor primario y cuerpo de clase

class_parameters: "(" [ parameter ("," parameter)* ] ")"
// por ejemplo, parámetros de constructor entre paréntesis

class_body: "{" (declaration (";" declaration)*)? ";"? "}"

// Declaración de función 
// Ahora se define 'function_body' como un bloque, representando el cuerpo de la función.
function_declaration: FUN simple_identifier function_value_parameters (":" type)? function_body?

// Definición del cuerpo de la función: se considera un bloque.
function_body: block

function_value_parameters: "(" [ function_value_parameter ("," function_value_parameter)* ] ")"
// lista de parámetros en declaración de función

function_value_parameter: parameter ("=" expression)?
// un parámetro con valor por defecto opcional

parameter: simple_identifier ":" type
parameter_with_optional_type: simple_identifier [ ":" type ]
// utilizado para parámetro de setter (tipo opcional)

// Declaración de propiedad 
property_declaration: (VAL | VAR) variable_declaration ("=" expression)?
// una propiedad simple con inicializador opcional
// (getters/setters y delegados omitidos por simplicidad)

variable_declaration: simple_identifier (":" type)?
// nombre de variable con tipo opcional

// Sentencias (parte imperativa)
statement: label* (declaration 
                 | assignment 
                 | loop_statement 
                 | expression)
// una sentencia puede ser una declaración local, una asignación, un bucle, o cualquier expresión (incluyendo if, when, etc.)

loop_statement: for_statement 
              | while_statement 
              | do_while_statement

for_statement: FOR "(" variable_declaration IN expression ")" statement
while_statement: WHILE "(" expression ")" statement
do_while_statement: DO statement WHILE "(" expression ")"

// Asignación
assignment: assignable ("=" | "+=" | "-=" | "*=" | "/=" | "%=") expression

assignable: simple_identifier 
// (Se puede extender a referencias a miembros o índices)

// Expresiones (incluye estructuras de control y formas básicas de expresiones. 
// La precedencia de operadores puede ampliarse de forma similar.)
expression: disjunction

// Disyunción y conjunción lógicas (ejemplo de operadores binarios)
disjunction: conjunction (OR conjunction)*
conjunction: equality (AND equality)*

// Comparación de igualdad (ejemplo)
equality: primary_expression ((EQ_OP | NOT_EQ_OP) primary_expression)*

// Expresiones primarias (operandos)
primary_expression: literal 
                  | simple_identifier 
                  | "(" expression ")" 
                  | if_expression 
                  | when_expression 
                  | try_expression 
                  | jump_expression

// Expresión if
if_expression: IF "(" expression ")" statement (ELSE statement)?

// Expresión when (similar a switch)
when_expression: WHEN when_subject? "{" when_entry* "}"

// sujeto opcional (con declaración de variable opcional)
when_subject: "(" (VAL variable_declaration "=")? expression ")"

when_entry: (when_condition ("," when_condition)*) "->" statement 
          | "else" "->" statement

when_condition: expression 
              | range_test 
              | type_test

range_test: IN expression 
          | NOT_IN expression

type_test: IS type 
         | NOT_IS type

// Expresión try
try_expression: TRY block ((catch_block)+ FINALLY? | FINALLY)

catch_block: CATCH "(" simple_identifier ":" type ")" block
finally_block: FINALLY block

// Expresiones de salto (returns y saltos)
jump_expression: THROW expression 
               | RETURN ["@" IDENTIFIER] expression? 
               | BREAK ["@" IDENTIFIER] 
               | CONTINUE ["@" IDENTIFIER]

// Bloques y etiquetas
block: "{" (statement (";" statement)*)? ";"? "}"
label: simple_identifier "@"

// Tipos simples y literales
type: simple_identifier  // simplificado: solo un identificador como nombre de tipo

simple_identifier: IDENTIFIER

literal: NUMBER | STRING | "true" | "false"  // literales básicos

// -----------------
// Tokens léxicos
// -----------------
CLASS: "class"
FUN: "fun"
VAL: "val"
VAR: "var"

IF: "if"
ELSE: "else"
WHEN: "when"
FOR: "for"
WHILE: "while"
DO: "do"

TRY: "try"
CATCH: "catch"
FINALLY: "finally"

RETURN: "return"
BREAK: "break"
CONTINUE: "continue"
THROW: "throw"

IN: "in"
NOT_IN: "!in"
IS: "is"
NOT_IS: "!is"

OR: "||"
AND: "&&"
EQ_OP: "=="
NOT_EQ_OP: "!="
// Se pueden agregar operadores adicionales (>=, <=, etc.) de forma similar

IDENTIFIER: /[A-Za-z_][A-Za-z_0-9]*/  // patrón de identificador (letras ASCII y dígitos)
NUMBER: /\d+/
STRING: /"([^"\\]|\\.)*"/  // cadena entre comillas dobles con secuencias de escape simples

// Ignorar espacios en blanco y comentarios
%ignore /[ \t\f]+/        // ignorar espacios en blanco intermedios
%ignore /\/\/[^\n]*/      // ignorar comentarios de línea
%ignore /\r?\n/           // ignorar nuevas líneas (tratar saltos de línea como espacios)
