            "text/markdown": "<span class=\"markdown prose dark:prose-invert contents\"><h2 id=\"5-floundering\">5 \u2014 Floundering</h2>\n<span class=\"paragraph\">Querying <code>safe(Q)</code> with unbound <code>Q</code> can't decide <code>not blocked(Q)</code> \u2192 <code>Floundered</code>.</span></span>"
          }
